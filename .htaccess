# AMANDE — SEO técnico (Apache / cPanel)
# www = sitio institucional | shop = Tienda Nube

Options -MultiViews
DirectoryIndex index.html

# Si sitemap.xml da 500 en el hosting, forzamos tipo MIME
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS + apex → www ---
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^amandesub\.com\.ar$ [NC]
  RewriteRule ^ https://www.amandesub.com.ar%{REQUEST_URI} [L,R=301]

  # --- Rutas institucionales (NO redirigir a shop) ---
  RewriteRule ^(regalos-personalizados|impresion-3d|regalos-empresas|personaliza-tu-producto|nosotros|contacto)(/|$) - [L]
  RewriteRule ^(assets|robots\.txt|sitemap\.xml|favicon) - [L]

  # --- URLs viejas de Tienda Nube en www → shop ---
  RewriteRule ^productos/(.*)$ https://shop.amandesub.com.ar/productos/$1 [L,R=301,NE,QSA]

  RewriteRule ^mas/quienes-somos1/?$ /nosotros/ [L,R=301]
  RewriteRule ^quienes-somos/?$ /nosotros/ [L,R=301]

  # Categorías / colecciones conocidas → shop
  RewriteRule ^hogar-y-deco(/.*)?$ https://shop.amandesub.com.ar/hogar-y-deco$1 [L,R=301,NE,QSA]
  RewriteRule ^herramientas(/.*)?$ https://shop.amandesub.com.ar/herramientas$1 [L,R=301,NE,QSA]
  RewriteRule ^reposteria1(/.*)?$ https://shop.amandesub.com.ar/reposteria1$1 [L,R=301,NE,QSA]
  RewriteRule ^juegos(/.*)?$ https://shop.amandesub.com.ar/juegos$1 [L,R=301,NE,QSA]
  RewriteRule ^bazar(/.*)?$ https://shop.amandesub.com.ar/bazar$1 [L,R=301,NE,QSA]
  RewriteRule ^indumentaria(/.*)?$ https://shop.amandesub.com.ar/indumentaria$1 [L,R=301,NE,QSA]
  RewriteRule ^personajes(/.*)?$ https://shop.amandesub.com.ar/personajes$1 [L,R=301,NE,QSA]
  RewriteRule ^llaveros(/.*)?$ https://shop.amandesub.com.ar/llaveros$1 [L,R=301,NE,QSA]
  RewriteRule ^cortantes-para-galletitas(/.*)?$ https://shop.amandesub.com.ar/cortantes-para-galletitas$1 [L,R=301,NE,QSA]
  RewriteRule ^fechas-especiales(/.*)?$ https://shop.amandesub.com.ar/fechas-especiales$1 [L,R=301,NE,QSA]
  RewriteRule ^deco-hogar(/.*)?$ https://shop.amandesub.com.ar/deco-hogar$1 [L,R=301,NE,QSA]
  RewriteRule ^cuenta(/.*)?$ https://shop.amandesub.com.ar/cuenta$1 [L,R=301,NE,QSA]
  RewriteRule ^carrito(/.*)?$ https://shop.amandesub.com.ar/carrito$1 [L,R=301,NE,QSA]
  RewriteRule ^checkout(/.*)?$ https://shop.amandesub.com.ar/checkout$1 [L,R=301,NE,QSA]
  RewriteRule ^buscar(/.*)?$ https://shop.amandesub.com.ar/buscar$1 [L,R=301,NE,QSA]
  RewriteRule ^politicas-de(/.*)?$ https://shop.amandesub.com.ar/politicas-de$1 [L,R=301,NE,QSA]
  RewriteRule ^como-comprar/?$ https://shop.amandesub.com.ar/como-comprar/ [L,R=301]
</IfModule>

# Caché ligera de estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
